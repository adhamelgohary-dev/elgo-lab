# Elgo Lab Self-Hosted Environment Example
# Copy to `.env` for VPS / bare-metal Node.js hosting.

PORT=4183
HOST=0.0.0.0
ELGO_DATA_DIR=./data-store

# Generate securely with: node tools/admin-password.js --hash
# (Takes precedence over plaintext ADMIN_PASSWORD)
ADMIN_PASSWORD_HASH=

# Fallback plaintext admin password (for quick local testing only)
# ADMIN_PASSWORD=change-me-strong-password

# Set to 1 only when running behind a trusted reverse proxy (Nginx / Caddy / Cloudflare Tunnel)
TRUST_PROXY=0
